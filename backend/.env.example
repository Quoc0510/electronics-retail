# Sao chép file này thành .env rồi chỉnh giá trị cho máy của bạn: cp .env.example .env
NODE_ENV=development
PORT=4000

# Chuỗi kết nối PostgreSQL (khớp với docker-compose.yml ở thư mục gốc)
DATABASE_URL="postgresql://electronics:electronics_dev@localhost:54320/electronics_retail?schema=public"

# Danh sách origin được phép gọi API (client, admin), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Khóa ký access token (JWT). Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Số request tối đa tới /api / 15 phút / IP
API_RATE_LIMIT=300

# Số lần đăng nhập tối đa / 15 phút / IP (US-02)
LOGIN_RATE_LIMIT=10

# [F13] Số lần đặt hàng của khách vãng lai và số lần tra cứu/hủy đơn (mã đơn + số điện thoại) tối đa / 15 phút / IP
GUEST_ORDER_RATE_LIMIT=10
ORDER_LOOKUP_RATE_LIMIT=20

# Số lớp proxy (nginx...) đứng trước backend: 0 khi chạy trực tiếp, 1 khi chạy sau nginx như docker-compose.staging.yml
TRUST_PROXY=0

# [F09] Số lần xem trước mã giảm giá tối đa / 15 phút / IP
COUPON_RATE_LIMIT=30

# [F03] (Tùy chọn) Thư mục lưu ảnh tải lên, mặc định backend/uploads
# UPLOAD_DIR=uploads

# [F16] Giao Hàng Nhanh: để TRỐNG thì dùng phí vận chuyển cố định. Điền cả hai để tính phí theo địa chỉ giao hàng.
# Token và ShopId lấy ở https://developer.ghn.vn (production) hoặc https://developer.ghn.dev (staging); hai môi trường là hai tài khoản riêng.
# KHÔNG commit Token thật. Chỉ điền vào backend/.env (đã nằm trong .gitignore)
GHN_TOKEN=
GHN_SHOP_ID=
# Staging: https://dev-online-gateway.ghn.vn ; production: https://online-gateway.ghn.vn
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_TIMEOUT_MS=5000
# Phí cố định khi chưa bật GHN hoặc GHN không trả lời được (đồng)
SHIPPING_FALLBACK_FEE=30000
# Ngưỡng miễn phí vận chuyển MẶC ĐỊNH: tiền hàng sau giảm giá từ mức này thì miễn phí (cửa hàng chịu phí); 0 = không miễn phí.
# Admin đổi ở trang Cài đặt (lưu trong CSDL, ưu tiên hơn giá trị này); chưa đổi lần nào thì dùng giá trị này
SHIPPING_FREE_THRESHOLD=5000000
# Số lần ước tính phí / tra địa chỉ tối đa / 15 phút / IP
SHIPPING_RATE_LIMIT=120
