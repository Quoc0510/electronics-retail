// @feature [F00-F09] Lược đồ cơ sở dữ liệu PostgreSQL (Prisma ORM).
// Quy ước (docs/CODING_CONVENTION.md): model PascalCase số ít, bảng/cột snake_case qua @map/@@map.
// Tiền tệ lưu bằng Int (đơn vị VND) - quy tắc BR-01.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

// Luồng trạng thái đơn hàng: quy tắc BR-06
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED

  @@map("order_status")
}

// Hiện chỉ có COD; sẽ bổ sung VNPAY/ZALOPAY nếu làm F11
// [F09] Loại mã giảm giá: theo phần trăm tiền hàng hoặc số tiền cố định (US-24)
enum CouponType {
  PERCENT
  FIXED

  @@map("coupon_type")
}

enum PaymentMethod {
  COD

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PAID

  @@map("payment_status")
}

// ---------------------------------------------------------------------------
// [F01] Người dùng, phiên đăng nhập, sổ địa chỉ
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(CUSTOMER)
  // false = tài khoản bị khóa (US-27)
  isActive     Boolean  @default(true) @map("is_active")
  // [F13] BR-15: điểm thành viên = floor(totalSpent / 1.000.000), cộng khi đơn của thành viên hoàn thành (CHECK >= 0 trong migration)
  points       Int      @default(0)
  // [F13] BR-15: tổng tiền hàng (không tính phí vận chuyển) của mọi đơn COMPLETED của thành viên, dùng tính điểm cộng dồn (CHECK >= 0)
  totalSpent   Int      @default(0) @map("total_spent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses     Address[]
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  statusChanges OrderStatusHistory[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@map("users")
}

// Refresh token chỉ lưu bản băm (hash), không lưu token gốc, để lộ DB cũng không dùng được
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Có giá trị = đã bị thu hồi (đăng xuất hoặc khóa tài khoản)
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  province      String
  // Từ 2025 nhiều địa phương không còn cấp quận/huyện nên không bắt buộc (null = không có)
  district      String?
  ward          String
  street        String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// [F02] Danh mục và thương hiệu
// ---------------------------------------------------------------------------

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  // BR-09: không xóa cứng, chỉ ẩn
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

// ---------------------------------------------------------------------------
// [F03] Sản phẩm
// ---------------------------------------------------------------------------

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  slug        String   @unique
  description String   @default("")
  // BR-02: giá hiện hành = salePrice nếu có, ngược lại là price
  price       Int
  salePrice   Int?     @map("sale_price")
  // BR-03: tồn kho không âm (kiểm tra thêm bằng ràng buộc CHECK trong migration)
  stock       Int      @default(0)
  // Thông số kỹ thuật dạng cặp tên - giá trị, ví dụ {"Màn hình": "6.1 inch OLED"}
  specs       Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  categoryId  Int      @map("category_id")
  brandId     Int      @map("brand_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id])
  brand         Brand          @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt])
  @@map("products")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  url       String
  // Ảnh có sortOrder nhỏ nhất là ảnh đại diện
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// [F05] Giỏ hàng (BR-11: mỗi người dùng đúng một giỏ)
// ---------------------------------------------------------------------------

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Một sản phẩm chỉ xuất hiện một dòng trong giỏ (thêm lại thì cộng dồn số lượng)
  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// [F06, F07] Đơn hàng
// ---------------------------------------------------------------------------

model Order {
  id              Int           @id @default(autoincrement())
  // BR-12: mã đơn dạng TSyymmdd-xxxx
  code            String        @unique
  // [F13] null = đơn của khách vãng lai (đặt hàng không cần đăng nhập, BR-11)
  userId          Int?          @map("user_id")
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  // Tiền hàng, phí vận chuyển (BR-05), tổng thanh toán - đơn vị VND
  subtotal        Int
  shippingFee     Int           @map("shipping_fee")
  total           Int
  // BR-04: bản sao thông tin giao hàng tại thời điểm đặt
  recipientName   String        @map("recipient_name")
  phone           String
  shippingAddress String        @map("shipping_address")
  note            String?
  cancelReason    String?       @map("cancel_reason")
  // [F13] BR-15: điểm đã cộng cho thành viên khi đơn hoàn thành (0 nếu chưa hoàn thành hoặc là đơn khách vãng lai)
  pointsEarned    Int           @default(0) @map("points_earned")
  // [F13] Mã do trình duyệt sinh cho mỗi lần đặt của khách vãng lai: gửi lại cùng mã (bấm đúp, mất mạng rồi thử lại)
  // chỉ trả đơn đã tạo, không tạo đơn thứ hai
  idempotencyKey  String?       @unique @map("idempotency_key")
  // [F09] Số tiền được giảm trên tiền hàng (0 nếu không dùng mã) và bản sao mã đã dùng (BR-04, BR-14).
  // Tổng thanh toán = subtotal - discount + shippingFee; phí ship và điểm thành viên tính trên subtotal - discount
  discount        Int           @default(0)
  couponId        Int?          @map("coupon_id")
  couponCode      String?       @map("coupon_code")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon  Coupon?              @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int    @map("order_id")
  productId   Int    @map("product_id")
  // BR-04: bản sao tên, SKU, đơn giá tại thời điểm đặt
  productName String @map("product_name")
  productSku  String @map("product_sku")
  unitPrice   Int    @map("unit_price")
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Lịch sử đổi trạng thái để hiển thị dòng thời gian (US-17, US-19)
model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  status      OrderStatus
  note        String?
  // Người thực hiện thay đổi (khách hàng hoặc quản trị viên)
  changedById Int?        @map("changed_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// [F08] Đánh giá và yêu thích
// ---------------------------------------------------------------------------

// BR-13: chỉ người có đơn COMPLETED chứa sản phẩm mới được đánh giá; BR-19: mỗi người một đánh giá cho mỗi sản phẩm
model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  userId    Int      @map("user_id")
  // 1-5 sao (CHECK trong migration)
  rating    Int
  // Bình luận không bắt buộc, tối đa 500 ký tự (CHECK trong migration); chuỗi rỗng = không bình luận
  comment   String   @default("")
  // US-23: quản trị viên ẩn đánh giá vi phạm; đánh giá ẩn không hiện ở Client và không tính điểm trung bình
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isHidden, createdAt])
  @@index([userId])
  @@map("reviews")
}

// BR-20: danh sách yêu thích của thành viên, mỗi sản phẩm một lần, tối đa 100 sản phẩm
model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// [F09] Mã giảm giá (US-24, US-25, BR-14). Mã luôn lưu IN HOA; used_count chỉ tăng bằng câu UPDATE có điều kiện
// (used_count < max_uses) nên không bao giờ vượt số lượt tối đa dù nhiều đơn dùng cùng lúc.
model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  type      CouponType
  // PERCENT: 1-100 (phần trăm tiền hàng); FIXED: số tiền VND
  value     Int
  minOrder  Int        @default(0) @map("min_order")
  startsAt  DateTime   @map("starts_at")
  endsAt    DateTime   @map("ends_at")
  maxUses   Int        @map("max_uses")
  usedCount Int        @default(0) @map("used_count")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive, endsAt])
  @@map("coupons")
}
